# systemd 托管单元：把本文件安装到 /usr/lib/systemd/system/schedd.service
# 见《软件详细设计文档》与需求文档 UC5。
# 注意：Type=simple，中间件内部不要调用 daemon()（SIGHUP 已被接管，
#       若使用 ExecReload=kill -HUP 需在进程内自行处理）。

[Unit]
Description=CPU+XPU Heterogeneous Scheduling Middleware (schedd)
Documentation=file:/usr/share/doc/schedd/README.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/schedd --config /etc/schedd/schedd.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# 停机等待上限（详见设计 §6.3 第三条约束）：
# SIGTERM 后服务线程可能正卡在同步 Run() 里，epoll_wait 不会立即返回，
# 等待上界 = 推理硬超时 + 一次 setFreq I/O。此值必须**大于该上界**，
# 否则会被 SIGKILL 打断，留下未 unlink 的 .sock，下次 bind 直接失败。
TimeoutStopSec=30

# 设备与运行时目录
RuntimeDirectory=schedd
RuntimeDirectoryMode=0755

# 资源与安全
LimitNOFILE=65536
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=schedd

[Install]
WantedBy=multi-user.target
